# Benchmark scratch data. Requests, API responses, compile results, manifests,
# records, scorecards, and reports remain trackable for result auditing.
work/
results/*/cases/*/workspace/
results/*/cases/*/reunpacked/
results/*/cases/*/candidate.e
results/*/cases/*/candidate.exe
results/**/*.stdout.log
results/**/*.stderr.log
results/**/*.resume*.log

# Aborted or superseded exploratory runs (not published in README)
results/20260815-gpt-5.6-luna-max/
